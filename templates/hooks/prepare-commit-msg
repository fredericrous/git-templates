#!/bin/zsh
# Include the Issue Id if it's in the branch
# Author: https://github.com/fredericrous

# ONE pattern per id: [0-9] is understood by rg (Rust regex) and grep -E alike,
# where \d is not — so the fallback can't drift from the fast path.
JIRA_REGEX="[A-Z]{3,32}-[1-9][0-9]{1,31}"
KANBANIZE_ID="[0-9]{3,}"

# rg is the fast path but isn't everywhere. Unguarded, a missing rg leaves the
# id empty AND `$?` non-zero, so no Issue line is appended and the failure is
# invisible — the message just silently lacks its ticket.
# HOOKS_FORCE_GREP=1 exercises the fallback where rg IS installed.
if [[ -z $HOOKS_FORCE_GREP ]] && command -v rg > /dev/null 2>&1; then
    only_matching() { rg --only-matching "$1" }
else
    only_matching() { grep -oE "$1" }
fi

case "$2" in
    message) # use -m/-F
        : # do nothing
        ;;
    template) # use template (ex: -t option)
        : # do nothing
        ;;
    merge)
        : # do nothing
        ;;
    squash)
        : # do nothing
        ;;
    commit) # use -c/-C/--amend
        : # do nothing
        ;;
    *) # no option
        CURRENT_BRANCH=`git branch --show-current`
        JIRA_ID=`printf '%s\n' "$CURRENT_BRANCH" | only_matching "$JIRA_REGEX"`
        if [[ $? = 0 ]]; then
            echo "\nIssue: $JIRA_ID" >> "$1"
            exit 0
        fi

        ID=`printf '%s\n' "$CURRENT_BRANCH" | only_matching "$KANBANIZE_ID" | head -n 1`
        if [[ $? = 0 ]]; then
            echo "\nIssue: #id $ID" >> "$1"
            exit 0
        fi
        ;;
esac
exit 0
